{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lawirisk-ssk-production",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "lawirisk-ssk",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "NEXT_PUBLIC_DEMO_MODE": "false",
        "GEMINI_MODEL": "gemini-2.5-flash",
        "MALWARE_SCANNER_TRANSPORT": "vpc",
        "MALWARE_SCANNER_URL": "http://scanner-api:8080",
        "MALWARE_SCANNER_TIMEOUT_MS": "180000"
      },
      "vpc_services": [
        {
          "binding": "MALWARE_SCANNER_VPC",
          "service_id": "01a032f9-ac2d-78d2-ac83-0eaaca0cd4b2"
        }
      ],
      "secrets": {
        "required": [
          "NEXT_PUBLIC_SUPABASE_URL",
          "NEXT_PUBLIC_SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "PRIVATE_EVIDENCE_BUCKET",
          "MALWARE_SCANNER_TOKEN",
          "GEMINI_API_KEY",
          "N8N_AUTOMATION_WEBHOOK_URL",
          "N8N_DISPATCH_TOKEN",
          "N8N_CALLBACK_TOKEN",
          "APP_ORIGIN"
        ]
      }
    }
  }
}
