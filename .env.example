# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo mode is available only outside production. Set this explicitly for local UI clarity.
NEXT_PUBLIC_DEMO_MODE=true
APP_ORIGIN=http://localhost:3000

# Gemini AI (server-only; never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# n8n orchestration (server-only). Use two different random values, >= 32 bytes.
N8N_AUTOMATION_WEBHOOK_URL=
N8N_DISPATCH_TOKEN=
N8N_CALLBACK_TOKEN=

# Private Storage (server-only)
PRIVATE_EVIDENCE_BUCKET=evidence-vault

# Signed intake channels (server-only; never prefix with NEXT_PUBLIC_)
KOUPREY_SECRET_KEY=replace-with-a-long-random-secret
# JSON object mapping partner id to a long random bearer key
PARTNER_API_KEYS={"partner-id":"replace-with-a-long-random-key"}

# Approved automatic source connectors (server-only). These placeholders are
# for official API/OAuth credentials, not portal usernames/passwords.
FDA_SKYNET_API_BASE_URL=
FDA_SKYNET_CLIENT_ID=
FDA_SKYNET_CLIENT_SECRET=
HSS_OSS_API_BASE_URL=
HSS_OSS_API_TOKEN=
