# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo mode is available only outside production. Set this explicitly for local UI clarity.
NEXT_PUBLIC_DEMO_MODE=true
APP_ORIGIN=http://localhost:3000

# Private Storage (server-only)
PRIVATE_EVIDENCE_BUCKET=evidence-vault

# Optional malware scanner. It must accept multipart field `file` and return
# {"verdict":"CLEAN|INFECTED","scanner":"...","signature_version":"..."}.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
MALWARE_SCANNER_TIMEOUT_MS=15000

# Signed intake channels (server-only; never prefix with NEXT_PUBLIC_)
KOUPREY_SECRET_KEY=replace-with-a-long-random-secret
# JSON object mapping partner id to a long random bearer key
PARTNER_API_KEYS={"partner-id":"replace-with-a-long-random-key"}
