# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n Orchestration (Webhook)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/search

# Private Storage (server-only)
PRIVATE_EVIDENCE_BUCKET=evidence-vault

# Signed intake channels (server-only; never prefix with NEXT_PUBLIC_)
KOUPREY_SECRET_KEY=replace-with-a-long-random-secret
# JSON object mapping partner id to a long random bearer key
PARTNER_API_KEYS={"partner-id":"replace-with-a-long-random-key"}

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
